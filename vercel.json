{
  "buildCommand": "echo \"export const SUPABASE_URL = '$SUPABASE_URL'; export const SUPABASE_ANON_KEY = '$SUPABASE_ANON_KEY';\" > js/config.js",
  "outputDirectory": ".",
  "rewrites": [
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
